{
  "name": "github-pr-notifications",
  "version": "1.0.0",
  "description": "Browser notifications for GitHub PR CI status changes and comments, with PR bookmark syncing",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "build:zip": "node scripts/build.js --zip",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hbmartin/chrome-extension-github-pr-notifications.git"
  },
  "license": "MIT",
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5"
  }
}
